@model DevTrack.Core.Entities.WorkItem

@{
    ViewData["Title"] = "Delete Work Item";
}

<h1>Delete Work Item</h1>

<p>Are you sure you want to delete this work item?</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Sprint</dt>
    <dd class="col-sm-10">@Model.Sprint?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>