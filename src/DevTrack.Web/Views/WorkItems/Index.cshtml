@model IEnumerable<DevTrack.Core.Entities.WorkItem>
@using DevTrack.Core.Entities

@{
    ViewData["Title"] = "Work Items";
}

<h1>Work Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="table-card">
    <table class="table responsive-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Estimated Hours</th>
                <th>Sprint</th>
                <th class="action-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    WorkItemStatus.Backlog => "status-backlog",
                    WorkItemStatus.InProgress => "status-inprogress",
                    WorkItemStatus.InReview => "status-inreview",
                    WorkItemStatus.Done => "status-done",
                    _ => "status-backlog"
                };

                <tr>
                    <td data-label="Title" class="work-item-title">@item.Title</td>
                    <td data-label="Status"><span class="status-pill @statusClass">@item.Status</span></td>
                    <td data-label="Assigned to">@item.AssignedTo</td>
                    <td data-label="Estimated hours">@item.EstimatedHours</td>
                    <td data-label="Sprint">@item.Sprint?.Name</td>
                    <td data-label="Actions" class="action-cell">
                        <div class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
