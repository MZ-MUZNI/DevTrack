@model IEnumerable<DevTrack.Core.Entities.WorkItem>
@using DevTrack.Core.Entities

@{
    ViewData["Title"] = "Work Items";
}

<h1>Work Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="table-card">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th>Estimated Hours</th>
                <th>Sprint</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    WorkItemStatus.Backlog => "status-backlog",
                    WorkItemStatus.InProgress => "status-inprogress",
                    WorkItemStatus.InReview => "status-inreview",
                    WorkItemStatus.Done => "status-done",
                    _ => "status-backlog"
                };

                <tr>
                    <td>@item.Title</td>
                    <td><span class="status-pill @statusClass">@item.Status</span></td>
                    <td>@item.AssignedTo</td>
                    <td>@item.EstimatedHours</td>
                    <td>@item.Sprint?.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>