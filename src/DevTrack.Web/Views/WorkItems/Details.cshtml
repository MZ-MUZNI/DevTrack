@model DevTrack.Core.Entities.WorkItem

@{
    ViewData["Title"] = "Work Item Details";
}

<h1>Work Item Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Assigned To</dt>
        <dd class="col-sm-10">@Model.AssignedTo</dd>

        <dt class="col-sm-2">Estimated Hours</dt>
        <dd class="col-sm-10">@Model.EstimatedHours</dd>

        <dt class="col-sm-2">Sprint</dt>
        <dd class="col-sm-10">@Model.Sprint?.Name</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>