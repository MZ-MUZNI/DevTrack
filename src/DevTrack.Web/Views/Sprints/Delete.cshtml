@model DevTrack.Core.Entities.Sprint

@{
    ViewData["Title"] = "Delete Sprint";
}

<h1>Delete Sprint</h1>

<p>Are you sure you want to delete this sprint? Its WorkItems will also be deleted (cascade delete).</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Start</dt>
    <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>
    <dt class="col-sm-2">End</dt>
    <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
