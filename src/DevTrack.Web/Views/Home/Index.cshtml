@{
    ViewData["Title"] = "Home Page";
}

<section class="hero">
    <div class="hero-eyebrow">DevTrack</div>
    <h1>Track sprints without the overhead.</h1>
    <p class="lead">
        Projects, sprints, and work items - organized the way a small team
        actually works, not the way a big tool wants you to.
    </p>

    <div class="status-flow" aria-label="Work item status flow">
        <span class="status-pill status-backlog">Backlog</span>
        <span class="flow-arrow">→</span>
        <span class="status-pill status-inprogress">In Progress</span>
        <span class="flow-arrow">→</span>
        <span class="status-pill status-inreview">In Review</span>
        <span class="flow-arrow">→</span>
        <span class="status-pill status-done">Done</span>
    </div>
</section>
