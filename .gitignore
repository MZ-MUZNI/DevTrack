# .vs folder - Visual Studio's own working files, never source code
.vs/

# Build output folders - regenerated by `dotnet build`, never commit these
bin/
obj/

# User-specific files (per-developer settings, not shared)
*.user
*.suo
*.userosscache
*.sln.docstates

# EF Core / database local files (if you ever use SQLite locally)
*.db
*.db-shm
*.db-wal

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Publish output
**/[Pp]ublish/
*.pubxml

# macOS
.DS_Store

# Logs
*.log
